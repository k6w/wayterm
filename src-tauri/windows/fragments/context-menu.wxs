<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Component Id="ContextMenuEntries" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567890">

        <!-- Right-click on a folder → "Open in Wayterm" -->
        <RegistryKey
          Root="HKCU"
          Key="Software\Classes\Directory\shell\Wayterm"
          Action="createAndRemoveOnUninstall"
        >
          <RegistryValue Type="string" Value="Open in Wayterm" KeyPath="yes" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLDIR]wayterm.exe" />
        </RegistryKey>
        <RegistryKey
          Root="HKCU"
          Key="Software\Classes\Directory\shell\Wayterm\command"
          Action="createAndRemoveOnUninstall"
        >
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]wayterm.exe&quot; &quot;%V&quot;" />
        </RegistryKey>

        <!-- Right-click on folder background → "Open in Wayterm" -->
        <RegistryKey
          Root="HKCU"
          Key="Software\Classes\Directory\Background\shell\Wayterm"
          Action="createAndRemoveOnUninstall"
        >
          <RegistryValue Type="string" Value="Open in Wayterm" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLDIR]wayterm.exe" />
        </RegistryKey>
        <RegistryKey
          Root="HKCU"
          Key="Software\Classes\Directory\Background\shell\Wayterm\command"
          Action="createAndRemoveOnUninstall"
        >
          <RegistryValue Type="string" Value="&quot;[INSTALLDIR]wayterm.exe&quot; &quot;%V&quot;" />
        </RegistryKey>

      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
