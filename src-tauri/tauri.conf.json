{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Nexterm",
  "version": "0.5.2",
  "identifier": "com.nexterm.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexterm",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Modern terminal emulator with SSH management",
    "longDescription": "Nexterm is a cross-platform terminal emulator featuring a Warp-style block UI, split panes, SSH connection management, 10 built-in themes, and glassmorphism design.",
    "copyright": "Copyright 2026 Nexterm",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "fragmentPaths": ["./windows/fragments/context-menu.wxs"],
        "componentRefs": ["ContextMenuEntries"]
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBQTFFQ0NFRUYxOTU5M0QKUldROVdSbnZ6dXloS3JkZjZuR0xKeTl5OTdxYTNtckF3a2srdFR3ZHRES1hPRXJPZWJCbEZaQ04K",
      "endpoints": [
        "https://github.com/k6w/nexterm-terminal-app/releases/latest/download/latest.json"
      ]
    }
  }
}
